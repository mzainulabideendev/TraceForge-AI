# TraceForge AI - environment template
# Copy to .env (never commit .env) or set these values in your deployment environment.
# ASP.NET Core maps double underscores to configuration sections:
#   TraceForge__RateLimiting__PermitLimit  ->  TraceForge:RateLimiting:PermitLimit

# --- Runtime ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- Application settings (implemented) ------------------------------------
TraceForge__InstanceName=TraceForge AI

# Request limiting for /api/* and a tighter budget for credential endpoints.
TraceForge__RateLimiting__PermitLimit=120
TraceForge__RateLimiting__WindowSeconds=60
TraceForge__RateLimiting__QueueLimit=0
TraceForge__RateLimiting__AuthPermitLimit=10
TraceForge__RateLimiting__AuthWindowSeconds=300

# --- Authentication (implemented, Phase 1) ---------------------------------
# Leave self-registration disabled in production; the first account always boots as Administrator.
TraceForge__Auth__AllowSelfRegistration=false
# Must be true anywhere TLS is terminated in front of the API.
TraceForge__Auth__RequireSecureCookies=true
TraceForge__Auth__SessionMinutes=480
TraceForge__Auth__MaxFailedAttempts=5
TraceForge__Auth__LockoutMinutes=15

# --- Database (implemented, Phase 1) ---------------------------------------
# Development on the audited machine: SQLite, migrated automatically at startup.
#   TraceForge__Database__Provider=Sqlite
#   TraceForge__Database__ConnectionString=Data Source=traceforge-dev.db
#   TraceForge__Database__ApplyMigrationsOnStartup=true
#
# Deployment: PostgreSQL. Set the connection string from your secret store, never here.
# Supabase uses PostgreSQL; configure the connection string as a secret in the API host.
# Example format (replace every placeholder; do not commit a real password):
#   Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<secret>;SSL Mode=Require
TraceForge__Database__Provider=PostgreSql
TraceForge__Database__ConnectionString=
TraceForge__Database__ApplyMigrationsOnStartup=false

# --- Planned settings (NOT read by the application yet) --------------------
# Phase 7 (AI investigator) will add provider credentials. Until that phase is
# implemented these keys have no effect and must not be treated as supported.
#
# TraceForge__Ai__Provider=
# TraceForge__Ai__ApiKey=
