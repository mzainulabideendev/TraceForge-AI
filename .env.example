# TraceForge AI - environment template
# Copy to .env (never commit .env) or set these values in your deployment environment.
# ASP.NET Core maps double underscores to configuration sections:
#   TraceForge__RateLimiting__PermitLimit  ->  TraceForge:RateLimiting:PermitLimit

# --- Runtime ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- Application settings (implemented) ------------------------------------
TraceForge__InstanceName=TraceForge AI
TraceForge__RateLimiting__PermitLimit=120
TraceForge__RateLimiting__WindowSeconds=60
TraceForge__RateLimiting__QueueLimit=0

# --- Planned settings (NOT read by the application yet) --------------------
# Phase 1 (backend foundation) will add the database connection string.
# Phase 7 (AI investigator) will add provider credentials. Until those phases are
# implemented these keys have no effect and must not be treated as supported.
#
# ConnectionStrings__TraceForge=
# TraceForge__Ai__Provider=
# TraceForge__Ai__ApiKey=
