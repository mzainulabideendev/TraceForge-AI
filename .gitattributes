# Normalise line endings so the build is identical on Windows, Linux and macOS.
* text=auto eol=lf

*.csproj text eol=lf
*.slnx text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.trx binary
*.snk binary
