<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TraceForge.Migrations.PostgreSql</RootNamespace>
    <AssemblyName>TraceForge.Migrations.PostgreSql</AssemblyName>
    <Description>EF Core migrations for the PostgreSQL deployment profile.</Description>
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TraceForge.Infrastructure\TraceForge.Infrastructure.csproj" />
  </ItemGroup>

</Project>
